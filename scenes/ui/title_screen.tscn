theme_override_font_sizes/font_size = 14
text = "TRI-HERO PARTY & CONTROLS"
horizontal_alignment = 1

[node name="Body" type="Label" parent="ControlsModal/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 10
text = "• MOVE: [A/D] or Left/Right Arrow
• JUMP: [W] or [Space] (Kiri has Double Jump & Slow Fall!)
• ATTACK: [J] or [Z] or Left Click
• SPECIAL SKILL: [K] or [X]
    - Alex: Radiant Heal (recovers 25 HP) & Light Blast
    - Athena: Flame Dash Nova (charges through foes)
    - Kiri: Cyclone Launch & Knockback
• SWAP ACTIVE HERO: [Tab] or [Q] or Keys 1/2/3
• COMPANIONS: Uncontrolled party members trail beside you, illuminate the darkness, and automatically assist attack monsters!
• OBJECTIVE: Shatter all Void Stones to break the darkness and open the portal!"
autowrap_mode = 2

[node name="CloseButton" type="Button" parent="ControlsModal/Margin/VBox"]
custom_minimum_size = Vector2(100, 26)
layout_mode = 2
size_flags_horizontal = 4
text = "CLOSE"

